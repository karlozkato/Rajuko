# Copia este archivo como ".env" y rellena los valores.
# ".env" NUNCA se sube a GitHub (está en .gitignore).

# Puerto local del servidor (en Render lo asigna la plataforma)
PORT=3000

# --- Base de datos MySQL (TiDB Cloud Starter) ---
DB_HOST=gateway01.xxxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=rajuko
# TiDB Cloud exige conexión cifrada (TLS). Déjalo en true.
DB_SSL=true

# --- CORS: orígenes del frontend autorizados a llamar a la API ---
# Separados por coma, sin barra final y sin ruta.
# Live Server de VS Code usa 5500; GitHub Pages usa solo el dominio.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://karlozkato.github.io

# --- Autenticación del administrador ---
# Secreto con el que se firman los tokens de sesión (mínimo 32 caracteres).
# Genera uno aleatorio con este comando (Git Bash o cualquier terminal con Node):
#   node -p "require('crypto').randomBytes(48).toString('hex')"
# Si lo cambias, todas las sesiones abiertas dejan de ser válidas.
JWT_SECRET=cambiame
# Duración de la sesión (ejemplos: 30m, 2h)
JWT_EXPIRES_IN=2h

# --- Solo para "npm run admin:crear" (crear el administrador) ---
# Contraseña: entre 12 y 72 caracteres. Si contiene # o espacios, ponla entre comillas dobles.
# Después de crear el admin, BORRA la línea ADMIN_PASSWORD.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
